// Deploys the static website (website/dist) to trestl.dev as an assets-only Cloudflare Worker.
// The account comes from CLOUDFLARE_ACCOUNT_ID; see website/README.md.
{
  "name": "trestl-website",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "trestl.dev", "custom_domain": true }],
  // Serve only on trestl.dev, not on a workers.dev address or preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
