---
import { logoUrl, faviconUrl } from '../lib/brand';
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400-italic.css';
import Theme from '../components/Theme.astro';
import '../styles/site.css';
const repo = 'https://github.com/saynain/trestl';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ef" />
    <meta name="robots" content="noindex" />
    <Theme />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>Page not found — Trestl</title>
  </head>
  <body>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="Trestl home"><img src={logoUrl} width="35" height="28" alt="" /><span>trestl</span></a>
      <nav aria-label="Main navigation"><a href="/docs/">Docs</a></nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="not-found-title">
        <h1 id="not-found-title">This page is<br /><em>not here.</em></h1>
        <p class="hero-copy">The address may have changed, or the page never existed.</p>
        <div class="hero-actions"><a class="button primary" href="/">Go to the homepage <span aria-hidden="true">→</span></a><a class="button secondary" href="/docs/">Read the docs <span aria-hidden="true">→</span></a></div>
      </section>
    </main>
    <footer class="site-footer wrap"><a class="brand" href="/" aria-label="Trestl home"><img src={logoUrl} width="30" height="24" alt="" /><span>trestl</span></a><p>A little structure. A lot of possibility.</p><div><a href={repo}>Source code <span aria-hidden="true">↗</span></a><a href="/docs/">Documentation <span aria-hidden="true">↗</span></a></div></footer>
  </body>
</html>
