---
import { logoUrl, faviconUrl } from '../lib/brand';
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400-italic.css';
import ProductDemo from '../components/ProductDemo.astro';
import Integrations from '../components/Integrations.astro';
import Theme from '../components/Theme.astro';
import '../styles/site.css';
const repo = 'https://github.com/saynain/trestl';
const canonical = new URL(Astro.url.pathname, Astro.site);
const commands = {
  local: 'git clone https://github.com/saynain/trestl.git\ncd trestl\ncorepack enable\npnpm install --frozen-lockfile\npnpm dev',
  docker: 'git clone https://github.com/saynain/trestl.git\ncd trestl\ncp .env.example .env\n# Configure APP_SECRET and POSTGRES_PASSWORD\n# in .env before starting (see the guide).\ndocker compose up --build -d',
  kubernetes: 'git clone https://github.com/saynain/trestl.git\ncd trestl\n# Preview the example configuration:\nkubectl kustomize deploy/kubernetes/examples/basic\n# Follow the guide to configure your cluster.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ef" />
    <Theme />
    <meta name="description" content="Self-hosted project management for small technical teams. Lists, boards and timelines, linked Gitea and GitHub issues, and a CLI your coding agents can use. MIT-licensed, with every feature included." />
    <meta property="og:title" content="Trestl — Good work needs a little structure." />
    <meta property="og:description" content="Self-hosted project management for small technical teams. MIT-licensed, with every feature included." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>Trestl — Good work needs a little structure.</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="#" aria-label="Trestl home"><img src={logoUrl} width="35" height="28" alt="" /><span>trestl</span></a>
      <nav aria-label="Main navigation"><a href="#product">Product</a><a href="#integrations" class="integrations-nav">Integrations</a><a href="#open-source">Open source</a><a href="#get-started">Get started</a><a href="/docs/">Docs</a></nav>
      <div class="header-actions">
        <button class="theme-toggle" id="site-theme" type="button" role="switch" aria-label="Dark mode" aria-checked="false" title="Switch to dark mode">
          <span class="theme-toggle-thumb" aria-hidden="true"></span>
          <svg class="theme-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
          <svg class="theme-moon" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.8 13.1A8.5 8.5 0 0 1 10.9 3.2 8.7 8.7 0 1 0 20.8 13.1Z"/></svg>
        </button>
        <a class="github-link" href={repo} aria-label="GitHub" title="View source on GitHub"><svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.07c-3.09.67-3.74-1.31-3.74-1.31-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.67.08-.67 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.59 1.21 3.22.93.1-.72.39-1.21.71-1.49-2.47-.28-5.07-1.24-5.07-5.49 0-1.21.43-2.2 1.14-2.98-.12-.28-.49-1.41.11-2.94 0 0 .93-.3 3.05 1.14a10.66 10.66 0 0 1 5.56 0c2.12-1.44 3.05-1.14 3.05-1.14.6 1.53.23 2.66.11 2.94.71.78 1.14 1.77 1.14 2.98 0 4.26-2.6 5.21-5.08 5.49.4.35.76 1.02.76 2.06V22c0 .3.2.64.77.53A11.1 11.1 0 0 0 12 .9Z"/></svg></a>
      </div>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <h1 id="hero-title">Good work needs<br />a little <em>structure.</em></h1>
        <p class="hero-copy">Self-hosted project management for small technical teams.<br class="desktop-break" /> Boards, timelines, linked Git issues, and a CLI your coding agents can use.</p>
        <div class="hero-actions"><a class="button primary" href="#get-started">Get started <span aria-hidden="true">→</span></a><a class="button secondary" href="#demo">Explore the demo <span aria-hidden="true">↓</span></a></div>
        <p class="hero-note">MIT-licensed, with every feature included. One process on your laptop or server.</p>
      </section>
      <section class="demo-section wrap" aria-label="Try Trestl"><ProductDemo /><noscript><p class="noscript-note">This is a sample project. Enable JavaScript to add, edit, and move demo tasks.</p></noscript></section>
      <section class="product-story wrap" id="product" aria-labelledby="story-title">
        <div class="story-intro"><p class="section-label">A PLACE FOR THE WHOLE PICTURE</p><h2 id="story-title">From a passing<br />thought to a<br /><em>finished thing.</em></h2></div>
        <div class="feature-rows">
          <article><span class="feature-number">01</span><div><h3>Capture the small things.</h3><p>A private inbox for tasks, ideas, and the follow-ups you don’t want to forget. Get it out of your head and into a calmer place.</p></div></article>
          <article><span class="feature-number">02</span><div><h3>Give your projects a shape.</h3><p>Lists when you need focus. Boards when work is moving. Timelines, milestones, and diagrams for the bigger picture.</p><a href="#demo">Find your view <span aria-hidden="true">↗</span></a></div></article>
          <article><span class="feature-number">03</span><div><h3>Keep your context close.</h3><p>Connect GitHub, Gitea, and Confluence. Reach for the CLI, API, or Raycast. A workspace that fits the way you already work.</p></div></article>
        </div>
      </section>
      <Integrations />
      <section class="open-source" id="open-source" aria-labelledby="open-title"><div class="wrap open-grid">
        <div><h2 id="open-title">Good tools<br />should belong<br />to <em>everyone.</em></h2><p>One complete product. Free and open source.<br />No hidden enterprise edition. No features held back.</p><a href={`${repo}/blob/main/LICENSE`} class="text-link">Open code. An open invitation. <span aria-hidden="true">↗</span></a></div>
        <div class="promise"><div class="price">$0<span>Every feature. Every person.</span></div><ul><li><span class="promise-symbol" aria-hidden="true">〈/〉</span><div>MIT licensed<small>Use it. Change it. Make it your own.</small></div></li><li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="7" rx="1" /><rect x="3" y="14" width="18" height="7" rx="1" /><path d="M6 6.5h.01M6 17.5h.01M10 6.5h8M10 17.5h8" /></svg><div>Self-hosted, on your terms<small>Your machine or your infrastructure.</small></div></li><li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V6a4 4 0 0 1 8 0v4" /></svg><div>Your data stays yours<small>A home you control, from the start.</small></div></li></ul><p class="hosting-note">The software is free. You provide the hosting.</p></div>
      </div></section>
      <section class="get-started wrap" id="get-started" aria-labelledby="start-title">
        <div class="start-copy"><h2 id="start-title">Your next project<br />starts <em>here.</em></h2><p>Bring Trestl home. Run locally, with Docker,<br class="desktop-break" /> or on your own Kubernetes cluster.</p><a class="text-link" href="/docs/quick-start/">Read the getting started guide <span aria-hidden="true">↗</span></a><span class="release-note">An early release, made to grow with you.</span></div>
        <div class="install-block"><div class="terminal"><div class="terminal-header"><div role="tablist" aria-label="Installation method">{Object.keys(commands).map((method, i) => <button role="tab" id={`install-${method}`} aria-controls={`commands-${method}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-method={method}>{method === 'local' ? 'Local' : method === 'docker' ? 'Docker' : 'Kubernetes'}</button>)}</div><button class="copy-button" aria-label="Copy installation commands" title="Copy commands"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V4H4v12h4"/></svg><span>Copy</span></button></div>{Object.entries(commands).map(([method, command], i) => <pre role="tabpanel" id={`commands-${method}`} aria-labelledby={`install-${method}`} hidden={i !== 0} tabindex="0"><code>{command.split('\n').map(line => <span class:list={['code-line', { 'code-comment': line.startsWith('#') }]}><span class="prompt" aria-hidden="true">{line.startsWith('#') ? ' ' : '$'}</span>{line}</span>)}</code></pre>)}</div><div class="install-footnote"><span id="install-help">Node.js 22.9+ · pnpm 10.7.1</span><a id="install-guide" href="/docs/development/">Local guide <span aria-hidden="true">↗</span></a></div><p class="copy-status sr-only" role="status"></p></div>
      </section>
    </main>
    <footer class="site-footer wrap"><a class="brand" href="#" aria-label="Trestl home"><img src={logoUrl} width="30" height="24" alt="" /><span>trestl</span></a><p>A little structure. A lot of possibility.</p><div><a href={repo}>Source code <span aria-hidden="true">↗</span></a><a href="/docs/">Documentation <span aria-hidden="true">↗</span></a></div></footer>
    <script>
      const installTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-method]'));
      const help = document.querySelector('#install-help')!;
      const guide = document.querySelector<HTMLAnchorElement>('#install-guide')!;
      const guides: Record<string, [string, string, string]> = {
        local: ['Node.js 22.9+ · pnpm 10.7.1', 'Local guide', '/docs/development/'],
        docker: ['Docker + Compose · configure secrets before starting', 'Docker guide', '/docs/self-hosting/docker/'],
        kubernetes: ['An existing cluster · PostgreSQL · configuration required', 'Cluster guide', '/docs/self-hosting/kubernetes/'],
      };
      function selectMethod(tab: HTMLButtonElement) {
        const method = tab.dataset.method!;
        installTabs.forEach(item => { const active = item === tab; item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1; document.getElementById(`commands-${item.dataset.method}`)!.hidden = !active; });
        const [description, label, path] = guides[method]; help.textContent = description; guide.textContent = `${label} ↗`; guide.href = path;
      }
      installTabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectMethod(tab));
        tab.addEventListener('keydown', event => {
          let next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % installTabs.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + installTabs.length) % installTabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = installTabs.length - 1;
          else return;
          event.preventDefault(); selectMethod(installTabs[next]); installTabs[next].focus();
        });
      });
      document.querySelector('.copy-button')?.addEventListener('click', async () => {
        const lines = document.querySelectorAll('.terminal pre:not([hidden]) .code-line');
        const text = Array.from(lines, line => Array.from(line.childNodes).filter(node => node.nodeType === Node.TEXT_NODE).map(node => node.textContent).join('')).join('\n');
        const status = document.querySelector('.copy-status')!;
        const label = document.querySelector('.copy-button span')!;
        try { await navigator.clipboard.writeText(text); label.textContent = 'Copied'; status.textContent = 'Installation commands copied.'; window.setTimeout(() => { label.textContent = 'Copy'; }, 2000); }
        catch { status.textContent = 'Clipboard unavailable. Select and copy the commands from the terminal.'; label.textContent = 'Select text'; }
      });
    </script>
  </body>
</html>
