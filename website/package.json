{
  "name": "trestl-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:demo && astro dev --host 127.0.0.1",
    "build": "pnpm check:demo && pnpm build:demo && astro check && astro build && pnpm check:docs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "build:demo": "node ../node_modules/vite/bin/vite.js build --config demo/vite.config.ts",
    "test:demo": "node --import ../node_modules/tsx/dist/loader.mjs --test demo/*.test.ts",
    "check:demo": "node ../node_modules/typescript/bin/tsc --noEmit --project demo/tsconfig.json",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "~7.3.8",
    "fumadocs-core": "^16.15.9",
    "fumadocs-ui": "^16.15.9",
    "lucide-react": "^1.45.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.9": "^3.1.9",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
