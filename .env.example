# Copy to .env for Docker Compose; set fresh secrets before starting.
# pnpm dev loads this optional file. Existing shell variables take precedence.
# Generate each secret: openssl rand -hex 32
# Encrypts Git and sign-in credentials. Keep it with your backups. Without
# DATABASE_URL, Trestl generates one in its data directory when this is empty.
APP_SECRET=
# Hex avoids URL-encoding complications in the Compose DATABASE_URL.
POSTGRES_PASSWORD=
PORT=4317
# The address people open, when it is not http://localhost:PORT. Required behind
# an HTTPS reverse proxy. Scheme, host and optional port only, without a path.
# APP_ORIGIN=https://projects.example.com
# Cookies are always Secure with an HTTPS APP_ORIGIN. Without one, set true to
# force them; Compose defaults to false for plain-HTTP access.
# SECURE_COOKIES=true
# Compose runs the latest release. Set this to run another tag or your own build.
# TRESTL_IMAGE=ghcr.io/saynain/trestl:v0.6.0
# Empty uses local persistent PGlite in .data; Compose configures PostgreSQL itself.
# DATABASE_URL=postgresql://trestl:URL_ENCODED_PASSWORD@localhost:5432/trestl
# HOST=127.0.0.1
# Extra origins for legacy personal Git credentials. Admin-configured shared connections approve their own origin.
INTEGRATION_ALLOWED_ORIGINS=
# Exact Confluence origins allowed for personal search/preview connections.
# CONFLUENCE_ALLOWED_ORIGINS=https://example.atlassian.net,https://docs.example.com
CONFLUENCE_ALLOWED_ORIGINS=
INTEGRATION_SYNC_INTERVAL_MS=300000

# Optional GitHub App sign-in. Each self-hosted instance registers its own app.
# Setup: docs/github-app.md. Requires APP_ORIGIN and APP_SECRET above.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# Prefer Administration → Authentication after first-run setup.
# Optional legacy environment-based trusted proxy. See docs/proxy-auth.md.
AUTH_MODE=local
# Set these privately for AUTH_MODE=proxy; do not commit deployment values.
# PROXY_AUTH_SECRET=
# PROXY_AUTH_ALLOWED_DOMAINS=example.com
# PROXY_AUTH_ADMIN_EMAILS=admin@example.com
# PROXY_AUTH_PROVIDER=google
# INSTALLATION_ID=default
# PROXY_AUTH_LINK_EXISTING_EMAILS=
