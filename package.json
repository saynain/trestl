{
  "name": "trestl",
  "version": "0.6.0",
  "private": true,
  "description": "A self-hosted project workspace for personal projects and small teams",
  "license": "MIT",
  "homepage": "https://trestl.dev",
  "bugs": "https://github.com/saynain/trestl/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/saynain/trestl.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview:demo": "pnpm build && node scripts/preview-demo.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts cli/cli.test.mjs tests/*.test.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "cli": "node --import tsx cli/index.ts",
    "format": "prettier --write src server shared cli scripts tests vite.config.ts",
    "format:check": "prettier --check src server shared cli scripts tests vite.config.ts",
    "build:cli": "pnpm typecheck && node scripts/build-cli.mjs",
    "test:cli-package": "node --import tsx scripts/test-cli-package.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:desktop": "node --import tsx --test tests/desktop*.test.ts tests/desktop-release.test.mjs",
    "test:desktop-package": "node scripts/test-desktop-package.mjs",
    "desktop:version": "node scripts/desktop-release.mjs verify"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@fontsource-variable/inter": "^5.3.0",
    "fastify": "^5.6.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "11.17.2",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "pnpm": {
    "overrides": {
      "@excalidraw/excalidraw>nanoid": "^3.3.18",
      "@excalidraw/mermaid-to-excalidraw>nanoid": "^5.1.16",
      "lodash-es@<4.18.0": "^4.18.1",
      "mermaid>katex": "^0.18.2"
    }
  }
}
